{
    "venvPath": ".",
    "venv": "venv",
    "pythonVersion": "3.13",
    "typeCheckingMode": "basic",
    "reportMissingImports": "none",
    "reportMissingModuleSource": "none",
    "include": [
        "services/backend/api/app",
        "services/backend/api/tests",
        "scripts"
    ],
    "exclude": [
        "venv"
    ]
}
