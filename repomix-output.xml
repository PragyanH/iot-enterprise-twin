import { aegisCapabilities, architectureNodes, tierDescriptions, type ArchitectureNode } from "@/lib/industrialArchitecture";

const tierNodes = (tier: ArchitectureNode["tier"]) => architectureNodes.filter((node) => node.tier === tier);

function ArchitectureNodeCard({ node, selected, onSelect }: { node: ArchitectureNode; selected: boolean; onSelect: () => void }) {
