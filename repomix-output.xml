/* Clean Spaced Topology Canvas Styles */
.topology-mesh-container {
  margin-top: 24px;
  border: 1px solid var(--line);
  background: var(--color-surface);
  box-shadow: 0 12px 36px var(--color-shadow);
  padding: 24px;
  border-radius: 4px;
}

.mesh-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
}


.mesh-eyebrow-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.mesh-eyebrow {
  color: var(--cyan);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.mesh-badge {
  background: color-mix(in srgb, var(--cyan) 12%, transparent);
  border: 1px solid var(--cyan);
  color: var(--cyan);
  font-size: 8px;
  font-weight: 700;
  padding: 2px 6px;
  letter-spacing: 0.08em;
}

.mesh-main-title {
  font-size: 20px;
  font-weight: 700;
  margin: 6px 0 4px;
  color: var(--ink);
}

.mesh-subtitle {
  color: var(--muted);
  font-size: 12px;
  margin: 0;
  max-width: 680px;
}

.mesh-sim-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  background: color-mix(in srgb, var(--amber) 12%, var(--color-surface));
  border: 1px solid var(--amber);
  color: var(--amber);
  padding: 8px 14px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.06em;
  cursor: pointer;
  border-radius: 4px;
  transition: all 0.2s;
}

.mesh-sim-btn:hover,
.mesh-sim-btn.simulating {
  background: var(--amber);
  color: #000;
  box-shadow: 0 0 16px color-mix(in srgb, var(--amber) 40%, transparent);
}

.sim-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  animation: pulse-dot 1.2s infinite alternate;
}

@keyframes pulse-dot {
  from { opacity: 0.3; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1.3); }
}

.mesh-banner {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-top: 16px;
  background: color-mix(in srgb, var(--cyan) 6%, var(--color-surface-raised));
  border: 1px solid color-mix(in srgb, var(--cyan) 30%, transparent);
  padding: 12px 16px;
  border-radius: 4px;
  font-size: 11px;
  color: var(--ink);
  line-height: 1.45;
}

.mesh-banner-text strong {
  color: var(--cyan);
  margin-right: 6px;
}

.mesh-canvas {
  position: relative;
  margin-top: 20px;
  min-height: 560px;
  border: 1px solid var(--line);
  background: var(--color-base);
  border-radius: 4px;
  overflow: hidden;
}

.mesh-background-grid {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(color-mix(in srgb, var(--muted) 20%, transparent) 1px, transparent 1px);
  background-size: 24px 24px;
  pointer-events: none;
  opacity: 0.3;
}

.spatial-zone {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
  border-bottom: 1px dashed color-mix(in srgb, var(--line) 60%, transparent);
}

.zone-ent-top { top: 0; height: 180px; }
.zone-dmz-mid { top: 180px; height: 210px; }
