.module-modal-close:hover { color: var(--color-danger); border-color: var(--color-danger); }
/* Modern XAI Lab Industrial Styling */
.xai-demo-wrapper {
  min-width: 0;
  border: 1px solid var(--line);
  background: var(--color-surface);
  border-radius: 8px;
  box-shadow: 0 12px 36px var(--color-shadow);
  padding: 24px;
}

.xai-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--line);
}

.xai-header-bar h2 {
  font-size: 20px;
  font-weight: 700;
  margin: 6px 0 4px;
  color: var(--ink);
}

.xai-header-bar p {
  color: var(--muted);
  font-size: 12px;
  max-width: 620px;
}

.xai-header-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10px;
}

.xai-status-pill {
  font-size: 10px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 20px;
  border: 1px solid var(--line);
  background: var(--color-surface-raised);
}

.xai-status-pill i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green);
}

.pill-danger {
  border-color: var(--red);
  color: var(--red);
  background: color-mix(in srgb, var(--red) 8%, var(--color-surface));
}

.pill-danger i {
  background: var(--red);
  animation: pulse 1.4s infinite;
}

.xai-action-btn {
  padding: 10px 18px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-run {
  border: 1px solid var(--cyan);
  background: var(--cyan);
  color: #000;
}

.btn-run:hover {
  box-shadow: 0 0 16px color-mix(in srgb, var(--cyan) 40%, transparent);
  transform: translateY(-1px);
}

.btn-remediate {
  border: 1px solid var(--red);
  background: var(--red);
  color: #fff;
}

.btn-remediate:hover {
  box-shadow: 0 0 16px color-mix(in srgb, var(--red) 40%, transparent);
  transform: translateY(-1px);
}

/* Timeline Track */
.xai-timeline-track {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 8px;
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
}

.xai-track-step {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 8px;
  border-radius: 20px;
  border: 1px solid transparent;
  font-size: 9px;
  color: var(--muted);
  min-width: 0;
  transition: all 0.25s ease;
}

.step-circle {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  font-weight: 700;
  flex: 0 0 auto;
  transition: all 0.25s ease;
}

.step-label {
  font-weight: 600;
  letter-spacing: 0.04em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.step-complete {
  color: var(--ink);
}

.step-complete .step-circle {
  background: var(--green);
  border-color: var(--green);
  color: #000;
}

.step-current {
  color: var(--cyan);
  background: color-mix(in srgb, var(--cyan) 10%, transparent);
  border-color: var(--cyan);
  transform: translateY(-1px);
}

.step-current .step-circle {
  border-color: var(--cyan);
  background: var(--cyan);
  color: #000;
  box-shadow: 0 0 10px var(--cyan);
  animation: step-glow 1.2s ease-in-out infinite alternate;
}

@keyframes step-glow {
  from { box-shadow: 0 0 4px var(--cyan); }
  to { box-shadow: 0 0 14px var(--cyan); }
}

/* Node Glow Animations */
.node-pulse-cyan .node-bg {
  stroke: var(--cyan);
  filter: drop-shadow(0 0 6px color-mix(in srgb, var(--cyan) 40%, transparent));
}

.node-pulse-alert .node-bg {
  stroke: var(--red);
  filter: drop-shadow(0 0 8px color-mix(in srgb, var(--red) 50%, transparent));
  animation: node-flash 0.8s ease-in-out infinite alternate;
}

@keyframes node-flash {
  from { fill: var(--color-surface); }
  to { fill: color-mix(in srgb, var(--red) 14%, var(--color-surface)); }
}

/* Top Row: Architecture & Live Metrics */
.xai-top-row {
