.xai-metric-chip-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  padding-top: 12px;
}

.xai-metric-chip {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: 9px;
  color: var(--muted);
}

.xai-metric-chip b {
  font-size: 13px;
  color: var(--ink);
}

/* Bottom Row: Evidence & Technology */
.xai-bottom-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 240px;
  gap: 16px;
  margin-top: 16px;
}

.xai-evidence-panel, .xai-tech-card {
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--color-surface);
  padding: 18px;
}

.xai-evidence-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 14px;
}

.xai-calc-card {
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 12px;
  background: var(--color-surface-raised);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.calc-title {
  font-size: 8px;
  font-weight: 800;
  color: var(--cyan);
  letter-spacing: 0.08em;
}

.comparison-flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.calc-col {
  display: flex;
  flex-direction: column;
  gap: 3px;
  font-size: 11px;
}

.calc-col small {
  color: var(--muted);
  font-size: 8px;
}

.calc-col.col-alert b {
  color: var(--red);
}

.calc-arrow {
  color: var(--muted);
  font-size: 14px;
}

.calc-foot {
  font-size: 8px;
  color: var(--muted);
  border-top: 1px solid var(--line);
  padding-top: 6px;
}

.deviation-rows, .composer-rows {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 10px;
}

.dev-row, .comp-row {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
}

.dev-row b, .comp-row b {
  color: var(--ink);
  font-weight: 700;
}

.comp-trust-box {
  border-top: 1px solid var(--line);
  padding-top: 8px;
  margin-top: 4px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comp-trust-box strong {
  font-size: 18px;
}

.xai-tech-card h3 {
  font-size: 14px;
  margin: 6px 0 4px;
}

.xai-tech-card p {
  font-size: 10px;
  color: var(--muted);
  line-height: 1.45;
}

.xai-output-box {
  border-top: 1px solid var(--line);
  margin-top: 14px;
  padding-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.xai-output-box span {
  font-size: 8px;
  font-weight: 800;
  color: var(--cyan);
}

.xai-output-box strong {
  font-size: 10px;
  color: var(--ink);
}

.xai-scenario-footer {
  margin-top: 16px;
  padding: 12px 16px;
  border-radius: 6px;
  border: 1px solid var(--line);
  background: var(--color-surface-raised);
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 10px;
}

.xai-scenario-footer strong {
  color: var(--cyan);
}

.scenario-detail {
  color: var(--muted);
  margin-left: auto;
}
