}

.banner-text strong {
  color: var(--cyan);
  margin-right: 6px;
}

.topo-canvas {
  position: relative;
  margin-top: 20px;
  border: 1px solid var(--line);
  background: radial-gradient(circle at 50% 80%, color-mix(in srgb, var(--cyan) 5%, transparent) 0%, transparent 60%), var(--color-base);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  overflow: hidden;
}

.topo-svg-lines {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.topo-line {
  stroke: var(--line);
  stroke-width: 1.5;
  stroke-dasharray: 4 4;
}

.line-main {
  stroke: var(--color-border-strong);
  stroke-width: 2;
}

.line-telemetry {
  stroke: var(--cyan);
  stroke-width: 2;
}

.attack-path-line {
  stroke: var(--red);
  stroke-width: 3;
  stroke-dasharray: 6 4;
  animation: attack-flow 0.8s linear infinite;
}

@keyframes attack-flow {
  to { stroke-dashoffset: -20; }
}

.pulse-particle {
  fill: var(--cyan);
  animation: flow-particle 2.4s linear infinite;
}

@keyframes flow-particle {
  0% { transform: translateY(120px); opacity: 0; }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { transform: translateY(-300px); opacity: 0; }
}

.topo-zone {
  position: relative;
  z-index: 2;
  border: 1px solid var(--line);
  background: var(--color-surface);
  padding: 16px;
  border-radius: 4px;
}

.zone-header-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: color-mix(in srgb, var(--cyan) 12%, transparent);
  border: 1px solid var(--cyan);
  padding: 3px 8px;
  margin-bottom: 12px;
  border-radius: 3px;
}

.pill-dmz {
  background: color-mix(in srgb, var(--amber) 12%, transparent);
  border-color: var(--amber);
}

.pill-ot {
  background: color-mix(in srgb, var(--green) 12%, transparent);
  border-color: var(--green);
}

.zone-num {
  font-size: 8px;
  font-weight: 800;
  color: var(--cyan);
}

.pill-dmz .zone-num { color: var(--amber); }
.pill-ot .zone-num { color: var(--green); }

.zone-header-pill h3 {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.06em;
  margin: 0;
  color: var(--ink);
}

.zone-nodes-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 10px;
}

.topo-node-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--color-surface-raised);
  border: 1px solid var(--line);
  padding: 10px 12px;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.18s;
}

.topo-node-card:hover,
.topo-node-card.active {
  border-color: var(--cyan);
  box-shadow: 0 4px 16px color-mix(in srgb, var(--cyan) 20%, transparent);
  transform: translateY(-2px);
}

.pi-special-card {
  border: 2px solid var(--cyan);
  background: color-mix(in srgb, var(--cyan) 8%, var(--color-surface-raised));
}

.pi-live-badge {
  position: absolute;
  top: -8px;
  right: 10px;
  font-size: 7px;
  font-weight: 800;
  padding: 1px 5px;
  border-radius: 2px;
}

.pi-live-badge.tone-success { background: var(--green); color: #000; }
.pi-live-badge.tone-amber { background: var(--amber); color: #000; }
.pi-live-badge.tone-danger { background: var(--red); color: #fff; }

.node-card-icon {
  font-size: 18px;
}

.node-card-info {
  display: flex;
  flex-direction: column;
}

.node-card-info strong {
  font-size: 11px;
  color: var(--ink);
}

.node-card-info small {
  font-size: 9px;
  color: var(--muted);
}

.topo-boundary-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: color-mix(in srgb, var(--amber) 8%, var(--color-surface));
  border: 1px solid var(--amber);
  padding: 8px 16px;
  border-radius: 4px;
  color: var(--amber);
  font-size: 10px;
}

.boundary-label {
  font-weight: 800;
  letter-spacing: 0.08em;
}

.boundary-sub {
  color: var(--muted);
  font-size: 9px;
}

/* Aegis Placement Membrane */
.aegis-placement-membrane {
  margin-top: 16px;
  border: 2px solid var(--cyan);
  background: linear-gradient(135deg, color-mix(in srgb, var(--cyan) 12%, var(--color-surface)) 0%, var(--color-surface) 100%);
  box-shadow: 0 0 25px color-mix(in srgb, var(--cyan) 25%, transparent);
  padding: 14px 18px;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.25s;
}

.aegis-placement-membrane:hover,
.aegis-placement-membrane.active-membrane {
  box-shadow: 0 0 40px color-mix(in srgb, var(--cyan) 45%, transparent);
  transform: scale(1.01);
}

.aegis-placement-membrane.attack-active {
  border-color: var(--red);
  box-shadow: 0 0 35px color-mix(in srgb, var(--red) 45%, transparent);
}

.membrane-inner {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.membrane-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.membrane-lightning {
  font-size: 24px;
  color: var(--cyan);
}

.membrane-title {
  font-size: 14px;
  font-weight: 800;
  color: var(--cyan);
  letter-spacing: 0.05em;
}

.membrane-sub {
  display: block;
  font-size: 10px;
  color: var(--muted);
}

.membrane-chip {
  margin-left: auto;
  font-size: 8px;
  font-weight: 800;
  background: var(--cyan);
  color: #000;
  padding: 3px 8px;
  border-radius: 3px;
  letter-spacing: 0.08em;
}

.membrane-chips-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 9.5px;
  color: var(--muted);
  border-top: 1px dashed color-mix(in srgb, var(--cyan) 30%, transparent);
  padding-top: 8px;
}

/* Detail Drawer */
.topo-detail-drawer {
