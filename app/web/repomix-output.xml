/* Master Architectural Blueprint Map Styles */
.blueprint-map-container {
  position: relative;
  width: 100%;
  border: 1px solid var(--color-border-strong);
  border-radius: 6px;
  overflow: hidden;
  box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.4);
}

.nhce-blueprint-svg {
  width: 100%;
  height: auto;
  display: block;
}

.building-group {
  transition: transform 0.2s ease, filter 0.2s ease;
}

.building-group:hover {
  transform: translateY(-1px);
}

/* Interactive Blueprint Pins */
.blueprint-pin {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
  text-decoration: none;
  cursor: pointer;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.blueprint-pin:hover {
  transform: translate(-50%, -54%) scale(1.1);
  z-index: 20;
}

.pin-head {
  position: relative;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--color-surface);
  border: 2px solid var(--cyan);
  box-shadow: 0 4px 14px var(--color-shadow), 0 0 10px color-mix(in srgb, var(--cyan) 30%, transparent);
  display: grid;
  place-items: center;
  font-size: 14px;
}

.pin-tag {
  margin-top: 4px;
  background: var(--color-surface);
  border: 1px solid var(--line);
  padding: 2px 6px;
  border-radius: 3px;
  box-shadow: 0 2px 6px var(--color-shadow);
}

.pin-tag b {
  font-size: 9px;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.04em;
}

.pin-pulse {
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 2px solid var(--cyan);
  opacity: 0;
  animation: pin-wave 2s cubic-bezier(0, 0.2, 0.8, 1) infinite;
}

/* Status Specific Pin Glows */
.pin-status-healthy .pin-head { border-color: var(--green); }
.pin-status-healthy .pin-pulse { border-color: var(--green); }

.pin-status-warning .pin-head { border-color: var(--amber); }
.pin-status-warning .pin-pulse { border-color: var(--amber); }

.pin-status-critical .pin-head {
  border-color: var(--red);
  background: color-mix(in srgb, var(--red) 15%, var(--color-surface));
}

.pin-status-critical .pin-pulse {
  border-color: var(--red);
  animation: pin-wave 0.8s cubic-bezier(0, 0.2, 0.8, 1) infinite;
}

@keyframes pin-wave {
  0% { transform: scale(0.8); opacity: 0.8; }
  100% { transform: scale(1.6); opacity: 0; }
}

/* Rich Blueprint Tooltip */
.blueprint-tooltip {
  position: absolute;
  bottom: calc(100% + 12px);
  left: 50%;
  transform: translateX(-50%) translateY(6px);
  width: 220px;
  padding: 12px 14px;
  border-radius: 6px;
  background: var(--color-surface);
  border: 1px solid var(--cyan);
  box-shadow: 0 12px 30px var(--color-shadow), 0 0 16px color-mix(in srgb, var(--cyan) 20%, transparent);
  opacity: 0;
  pointer-events: none;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  gap: 5px;
  text-align: left;
  z-index: 30;
}

.blueprint-tooltip::after {
  content: "";
  position: absolute;
  bottom: -6px;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 10px;
  height: 10px;
  background: var(--color-surface);
  border-right: 1px solid var(--cyan);
  border-bottom: 1px solid var(--cyan);
}

.blueprint-pin:hover .blueprint-tooltip {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

.tooltip-header {
