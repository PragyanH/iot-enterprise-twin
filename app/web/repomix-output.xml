/* Node Glow Animations */
.node-pulse-cyan .node-bg {
  stroke: var(--cyan);
  filter: drop-shadow(0 0 6px color-mix(in srgb, var(--cyan) 40%, transparent));
}

.node-pulse-alert .node-bg {
