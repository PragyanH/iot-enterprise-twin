.mesh-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
}


.mesh-eyebrow-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.mesh-eyebrow {
  color: var(--cyan);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.mesh-badge {
  background: color-mix(in srgb, var(--cyan) 12%, transparent);
  border: 1px solid var(--cyan);
  color: var(--cyan);
  font-size: 8px;
  font-weight: 700;
  padding: 2px 6px;
  letter-spacing: 0.08em;
}

.mesh-main-title {
  font-size: 20px;
  font-weight: 700;
  margin: 6px 0 4px;
  color: var(--ink);
}

.mesh-subtitle {
  color: var(--muted);
  font-size: 12px;
  margin: 0;
  max-width: 680px;
}

.mesh-sim-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  background: color-mix(in srgb, var(--amber) 12%, var(--color-surface));
  border: 1px solid var(--amber);
  color: var(--amber);
  padding: 8px 14px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.06em;
  cursor: pointer;
  border-radius: 4px;
  transition: all 0.2s;
}

.mesh-sim-btn:hover,
.mesh-sim-btn.simulating {
  background: var(--amber);
  color: #000;
  box-shadow: 0 0 16px color-mix(in srgb, var(--amber) 40%, transparent);
}

.sim-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  animation: pulse-dot 1.2s infinite alternate;
}

@keyframes pulse-dot {
  from { opacity: 0.3; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1.3); }
}

.mesh-banner {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-top: 16px;
  background: color-mix(in srgb, var(--cyan) 6%, var(--color-surface-raised));
  border: 1px solid color-mix(in srgb, var(--cyan) 30%, transparent);
  padding: 12px 16px;
  border-radius: 4px;
  font-size: 11px;
  color: var(--ink);
  line-height: 1.45;
}

.mesh-banner-text strong {
  color: var(--cyan);
  margin-right: 6px;
}

.mesh-canvas {
  position: relative;
  margin-top: 20px;
  min-height: 560px;
  border: 1px solid var(--line);
  background: var(--color-base);
  border-radius: 4px;
  overflow: hidden;
}

.mesh-background-grid {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(color-mix(in srgb, var(--muted) 20%, transparent) 1px, transparent 1px);
  background-size: 24px 24px;
  pointer-events: none;
  opacity: 0.3;
}

.spatial-zone {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
  border-bottom: 1px dashed color-mix(in srgb, var(--line) 60%, transparent);
}

.zone-ent-top { top: 0; height: 180px; }
.zone-dmz-mid { top: 180px; height: 210px; }
.zone-ot-bot { top: 390px; height: 220px; border-bottom: 0; }

.zone-label-text {
  position: absolute;
  right: 16px;
  top: 10px;
  font-size: 8.5px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--muted);
  opacity: 0.5;
}

.mesh-svg-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
}

.clean-edge-line {
  stroke: color-mix(in srgb, var(--line) 85%, transparent);
  stroke-width: 1.5;
  transition: stroke 0.2s, stroke-width 0.2s;
}

.clean-edge-line.edge-highlight {
  stroke: var(--cyan);
  stroke-width: 2;
}


.firewall-barrier-group {
  pointer-events: auto;
}

.fw-barrier-line {
  stroke: var(--amber);
  stroke-width: 2;
  stroke-dasharray: 6 6;
  opacity: 0.7;
}

.fw-gate-pill {
  position: absolute;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 4;
  background: var(--color-surface);
  border: 1.5px solid var(--amber);
  color: var(--amber);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  padding: 4px 14px;
  border-radius: 12px;
  box-shadow: 0 2px 10px color-mix(in srgb, var(--amber) 20%, transparent);
  white-space: nowrap;
  pointer-events: auto;
}


.attack-path-vector {
  fill: none;
  stroke: var(--red);
  stroke-width: 3.5;
  stroke-dasharray: 8 6;
  animation: attack-flow 0.6s linear infinite;
}

@keyframes attack-flow {
  to { stroke-dashoffset: -20; }
}

.spaced-node-item {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 5;
  cursor: pointer;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  transition: transform 0.2s;
}

.spaced-node-item:hover,
.spaced-node-item.active {
  transform: translate(-50%, -50%) scale(1.1);
  z-index: 10;
}

.node-circle-badge {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--color-surface);
  border: 2px solid var(--line);
  box-shadow: 0 4px 16px var(--color-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.spaced-node-item.active .node-circle-badge {
  border-color: var(--cyan);
  box-shadow: 0 0 20px color-mix(in srgb, var(--cyan) 50%, transparent);
}

.cat-security_ops .node-circle-badge { border-color: color-mix(in srgb, var(--cyan) 70%, transparent); }
.cat-network .node-circle-badge { border-color: color-mix(in srgb, var(--amber) 70%, transparent); }
.cat-physical .node-circle-badge { border-color: color-mix(in srgb, var(--green) 70%, transparent); }

.node-icon-symbol {
  font-size: 24px;
}

.node-label-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-top: 6px;
  white-space: nowrap;
}

.node-label-block strong {
  font-size: 12px;
  color: var(--ink);
  font-weight: 800;
  text-shadow: 0 1px 3px var(--color-base), 0 0 6px var(--color-base);
  letter-spacing: 0.02em;
}

.node-label-block small {
  font-size: 9.5px;
  color: var(--muted);
  font-weight: 600;
  text-shadow: 0 1px 2px var(--color-base);
}

.pi-hw-pill {
  position: absolute;
  top: -14px;
  font-size: 8px;
  font-weight: 800;
  padding: 2px 7px;
  border-radius: 3px;
  white-space: nowrap;
  letter-spacing: 0.05em;
}


.pi-hw-pill.tone-success { background: var(--green); color: #000; }
.pi-hw-pill.tone-amber { background: var(--amber); color: #000; }
.pi-hw-pill.tone-danger { background: var(--red); color: #fff; }

/* Aegis Membrane Sleek Capsule Overlay */
.aegis-membrane-capsule {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 8;
  display: flex;
  align-items: center;
  gap: 12px;
  background: color-mix(in srgb, var(--cyan) 12%, var(--color-surface));
  border: 2px solid var(--cyan);
  box-shadow: 0 0 30px color-mix(in srgb, var(--cyan) 30%, transparent);
  padding: 8px 18px;
  border-radius: 24px;
  cursor: pointer;
  transition: all 0.2s;
}

.aegis-membrane-capsule:hover,
.aegis-membrane-capsule.active-capsule {
  box-shadow: 0 0 45px color-mix(in srgb, var(--cyan) 50%, transparent);
  transform: translate(-50%, -50%) scale(1.04);
}

.capsule-icon {
  font-size: 22px;
  color: var(--cyan);
}

.capsule-info strong {
  display: block;
  font-size: 12px;
  color: var(--cyan);
  letter-spacing: 0.05em;
}

.capsule-info small {
  display: block;
  font-size: 9px;
  color: var(--muted);
}

.capsule-tag {
  font-size: 8px;
  font-weight: 800;
  background: var(--cyan);
  color: #000;
  padding: 2px 6px;
  border-radius: 3px;
  letter-spacing: 0.08em;
}

/* Drawer */
.mesh-drawer {
  margin-top: 16px;
  border: 1px solid var(--cyan);
  background: color-mix(in srgb, var(--cyan) 6%, var(--color-surface));
  padding: 16px;
  border-radius: 4px;
}

.drawer-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.drawer-cat-badge {
  font-size: 8px;
  font-weight: 800;
  padding: 2px 6px;
  border-radius: 2px;
  display: inline-block;
  margin-bottom: 4px;
}

.drawer-aegis-tag {
  font-size: 8px;
  font-weight: 800;
  color: var(--cyan);
  margin-left: 8px;
}

.drawer-title-group h3 {
  font-size: 16px;
  margin: 2px 0 0;
  color: var(--ink);
}

.drawer-title-group small {
  font-size: 10px;
  color: var(--muted);
}

.drawer-close {
  background: transparent;
  border: 0;
  color: var(--muted);
  font-size: 16px;
  cursor: pointer;
}

.drawer-description {
  font-size: 11px;
  color: var(--muted);
  line-height: 1.5;
  margin: 10px 0;
}

.drawer-deps {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 10px;
  color: var(--muted);
  border-top: 1px dashed var(--line);
  padding-top: 10px;
}

.dep-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.dep-chip {
  background: var(--color-surface-raised);
  border: 1px solid var(--line);
  padding: 2px 6px;
  font-size: 9px;
  color: var(--ink);
}

.mesh-legend-strip {
  margin-top: 16px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  font-size: 10px;
  border-top: 1px solid var(--line);
  padding-top: 12px;
}

.legend-title {
  font-weight: 700;
  color: var(--muted);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--muted);
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.dot.cat-physical { background: var(--green); }
.dot.cat-network { background: var(--amber); }
.dot.cat-security_ops { background: var(--cyan); }
.dot.cat-aegis { background: var(--cyan); box-shadow: 0 0 8px var(--cyan); }


