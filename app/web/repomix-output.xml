}

.btn-run {
  border: 1px solid var(--cyan);
  background: var(--cyan);
  color: #000;
}

.btn-run:hover {
  box-shadow: 0 0 16px color-mix(in srgb, var(--cyan) 40%, transparent);
  transform: translateY(-1px);
}

.btn-remediate {
  border: 1px solid var(--red);
  background: var(--red);
  color: #fff;
}

.btn-remediate:hover {
  box-shadow: 0 0 16px color-mix(in srgb, var(--red) 40%, transparent);
  transform: translateY(-1px);
}

/* Timeline Track */
.xai-timeline-track {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 8px;
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
}

.xai-track-step {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 8px;
  border-radius: 20px;
  border: 1px solid transparent;
  font-size: 9px;
  color: var(--muted);
  min-width: 0;
  transition: all 0.25s ease;
}

.step-circle {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  font-weight: 700;
  flex: 0 0 auto;
  transition: all 0.25s ease;
}

.step-label {
  font-weight: 600;
  letter-spacing: 0.04em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.step-complete {
  color: var(--ink);
}

.step-complete .step-circle {
  background: var(--green);
  border-color: var(--green);
  color: #000;
}

.step-current {
  color: var(--cyan);
  background: color-mix(in srgb, var(--cyan) 10%, transparent);
  border-color: var(--cyan);
  transform: translateY(-1px);
}

.step-current .step-circle {
  border-color: var(--cyan);
  background: var(--cyan);
  color: #000;
  box-shadow: 0 0 10px var(--cyan);
